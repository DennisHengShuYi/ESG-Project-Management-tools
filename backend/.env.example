PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
JWT_SECRET=replace-with-a-long-random-string

# Optional: extra allowed CORS origin, on top of the built-in localhost
# defaults (5173, 3000). Set this to your deployed frontend's URL.
# FRONTEND_ORIGIN=https://your-deployed-frontend.example.com

# Only needed once, to run scripts/migrate.cjs (find it under
# Project Settings -> Database -> Connection string):
# $env:DB_PASSWORD = "your-database-password"
